# Copy to .env for local development. In production Coolify supplies these.

# From the Discord Developer Portal, "Bot" page.
DISCORD_TOKEN=your-bot-token

# Matches docker-compose.yml.
DATABASE_URL=postgres://postgres:traveller@localhost:5432/traveller

# Optional. Registers commands into one server instead of globally, which is
# instant rather than taking up to an hour to propagate.
# DISCORD_DEV_GUILD_ID=your-test-server-id

# Optional. Without it errors only reach the container logs.
# SENTRY_DSN=https://...ingest.sentry.io/...
