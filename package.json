{
	"name": "traveller",
	"version": "0.11.6",
	"description": "Automation bot for ukrainian servers, Cloudflare Workers edition",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "wrangler dev",
		"deploy": "wrangler deploy",
		"register": "node src/register.ts",
		"db:migrate": "wrangler d1 migrations apply traveller --local",
		"db:migrate:remote": "wrangler d1 migrations apply traveller --remote",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "wrangler types --include-env=false && tsc --noEmit",
		"lint": "biome check",
		"fix": "biome check --write",
		"prepare": "lefthook install || true"
	},
	"dependencies": {
		"discord-interactions": "^4.4.0",
		"itty-router": "^5.0.24"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@cloudflare/vitest-plugin": "^1.1.3",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/node": "^26.4.1",
		"discord-api-types": "^0.38.55",
		"lefthook": "^2.1.12",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.128.0"
	}
}
