{
	"name": "traveller",
	"version": "0.11.6",
	"description": "Automation bot for ukrainian servers",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"start": "node src/index.ts",
		"dev": "node --watch src/index.ts",
		"db:migrate": "node src/migrate.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"fix": "biome check --write",
		"prepare": "lefthook install || true"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/node": "^26.4.1",
		"@types/pg": "^8.23.1",
		"lefthook": "^2.1.12",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@sentry/node": "^10.73.0",
		"discord.js": "^14.27.0",
		"pg": "^8.23.0"
	}
}
