{
  "name": "traveller",
  "version": "0.11.6",
  "description": "Automation bot for ukrainian servers, Cloudflare Workers edition",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "register": "node src/register.ts",
    "db:migrate": "wrangler d1 migrations apply traveller --local",
    "db:migrate:remote": "wrangler d1 migrations apply traveller --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wrangler types --include-env=false && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "fix": "eslint --fix . && prettier --write ."
  },
  "dependencies": {
    "discord-interactions": "^4.4.0",
    "itty-router": "^5.0.24"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "discord-api-types": "^0.38.55",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260831.1": true
  }
}
